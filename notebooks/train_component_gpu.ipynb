{
 "cells": [
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "# SmartPCB-XAI Component Model Training\n",
      "\n",
      "This notebook trains YOLO11s on the unified 6-class component dataset.\n",
      "\n",
      "**Dataset:** components_unified (train 804 / val 116 / test 89 images, 6 classes)\n",
      "**Classes:** ICs, capacitors, diodes, inductors, resistors, transistors"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Setup"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "!pip install ultralytics 2>&1 | tail -n 5"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "import os\n",
      "import random\n",
      "import json\n",
      "import pandas as pd\n",
      "import numpy as np\n",
      "from pathlib import Path\n",
      "from ultralytics import YOLO\n",
      "import torch\n",
      "\n",
      "# Set seeds for reproducibility\n",
      "random.seed(42)\n",
      "np.random.seed(42)\n",
      "torch.manual_seed(42)\n",
      "\n",
      "# Paths\n",
      "DATA_PATH = \"/kaggle/input/smartpcb-components/components\"  # Will be rewritten after upload\n",
      "OUTPUT_DIR = \"/kaggle/working\"\n",
      "\n",
      "print(f\"PyTorch version: {torch.__version__}\")\n",
      "print(f\"CUDA available: {torch.cuda.is_available()}\")\n",
      "print(f\"GPU count: {torch.cuda.device_count()}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Rewrite data.yaml path"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "import yaml\n",
      "\n",
      "# Read the uploaded data.yaml\n",
      "with open(f\"{DATA_PATH}/data.yaml\", 'r') as f:\n",
      "    data_config = yaml.safe_load(f)\n",
      "\n",
      "# Rewrite path to Kaggle input\n",
      "data_config['path'] = DATA_PATH\n",
      "\n",
      "# Save rewritten config\n",
      "with open(f\"{OUTPUT_DIR}/data_kaggle.yaml\", 'w') as f:\n",
      "    yaml.dump(data_config, f)\n",
      "\n",
      "print(\"data.yaml rewritten for Kaggle environment\")\n",
      "print(f\"Dataset path: {data_config['path']}\")\n",
      "print(f\"Classes: {data_config['names']}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Load COCO-pretrained YOLO11s"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "# Load COCO-pretrained weights\n",
      "model = YOLO('yolo11s.pt')\n",
      "\n",
      "print(f\"Model loaded: {model.model.type}\")\n",
      "print(f\"Parameters: {sum(p.numel() for p in model.model.parameters()):,}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Training Configuration"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "TRAINING_CONFIG = {\n",
      "    'data': f\"{OUTPUT_DIR}/data_kaggle.yaml\",\n",
      "    'epochs': 100,\n",
      "    'imgsz': 1024,  # Higher resolution for small components\n",
      "    'batch': 8,  # Smaller batch for higher resolution\n",
      "    'patience': 20,\n",
      "    'device': 0 if torch.cuda.is_available() else 'cpu',\n",
      "    'seed': 42,\n",
      "    'lr0': 0.01,\n",
      "    'lrf': 0.01,\n",
      "    'momentum': 0.937,\n",
      "    'weight_decay': 0.0005,\n",
      "    'warmup_epochs': 3,\n",
      "    'warmup_momentum': 0.8,\n",
      "    'name': 'component_yolo11s',\n",
      "    'project': f\"{OUTPUT_DIR}/runs\",\n",
      "    'exist_ok': True,\n",
      "    'verbose': False,\n",
      "    'plots': True,\n",
      "    'save': True,\n",
      "    'save_period': 10,\n",
      "}\n",
      "\n",
      "print(\"Training configuration:\")\n",
      "for k, v in TRAINING_CONFIG.items():\n",
      "    print(f\"  {k}: {v}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Train Model"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "# Train\n",
      "results = model.train(**TRAINING_CONFIG)\n",
      "\n",
      "print(\"\\nTraining completed!\")\n",
      "print(f\"Best model saved at: {results.save_dir}/weights/best.pt\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Load Best Model and Evaluate on Test Set"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "# Load best model\n",
      "best_model = YOLO(f\"{results.save_dir}/weights/best.pt\")\n",
      "\n",
      "# Evaluate on test set (ONCE, as specified)\n",
      "test_results = best_model.val(\n",
      "    data=f\"{OUTPUT_DIR}/data_kaggle.yaml\",\n",
      "    split='test',\n",
      "    imgsz=1024,\n",
      "    conf=0.001,\n",
      "    iou=0.6,\n",
      "    verbose=False\n",
      ")\n",
      "\n",
      "print(\"\\nTest evaluation completed!\")\n",
      "print(f\"mAP50: {test_results.box.map50:.4f}\")\n",
      "print(f\"mAP50-95: {test_results.box.map:.4f}\")\n",
      "print(f\"Precision: {test_results.box.mp:.4f}\")\n",
      "print(f\"Recall: {test_results.box.mr:.4f}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Save Metrics"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "# Save detailed metrics\n",
      "metrics = {\n",
      "    'model_type': 'YOLO11s',\n",
      "    'training': 'from_scratch_coco_pretrained',\n",
      "    'dataset': 'components_unified',\n",
      "    'train_images': 804,\n",
      "    'val_images': 116,\n",
      "    'test_images': 89,\n",
      "    'classes': ['ICs', 'capacitors', 'diodes', 'inductors', 'resistors', 'transistors'],\n",
      "    'test_map50': float(test_results.box.map50),\n",
      "    'test_map50_95': float(test_results.box.map),\n",
      "    'test_precision': float(test_results.box.mp),\n",
      "    'test_recall': float(test_results.box.mr),\n",
      "    'seed': 42,\n",
      "    'epochs_trained': len(results.results),\n",
      "    'device': str(test_results.device),\n",
      "    'imgsz': 1024,\n",
      "}\n",
      "\n",
      "# Per-class metrics\n",
      "per_class = {}\n",
      "for i, class_name in enumerate(metrics['classes']):\n",
      "    per_class[class_name] = {\n",
      "        'ap50': float(test_results.box.maps[i]),\n",
      "        'ap50_95': float(test_results.box.maps[i]),\n",
      "        'precision': float(test_results.box.p[i]),\n",
      "    }\n",
      "\n",
      "metrics['per_class'] = per_class\n",
      "\n",
      "# Save metrics\n",
      "with open(f\"{OUTPUT_DIR}/component_training_metrics.json\", 'w') as f:\n",
      "    json.dump(metrics, f, indent=2)\n",
      "\n",
      "# Save as CSV\n",
      "df = pd.DataFrame([metrics])\n",
      "df.to_csv(f\"{OUTPUT_DIR}/component_training_metrics.csv\", index=False)\n",
      "\n",
      "print(\"Metrics saved!\")\n",
      "print(f\"mAP50: {metrics['test_map50']:.4f}\")\n",
      "print(f\"mAP50-95: {metrics['test_map50_95']:.4f}\")\n",
      "print(f\"\\nPer-class AP50:\")\n",
      "for class_name, class_metrics in per_class.items():\n",
      "    print(f\"  {class_name}: {class_metrics['ap50']:.4f}\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Zip Outputs for Download"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "import zipfile\n",
      "import os\n",
      "\n",
      "# Create zip with all outputs\n",
      "zip_path = f\"{OUTPUT_DIR}/component_training_outputs.zip\"\n",
      "with zipfile.ZipFile(zip_path, 'w') as zipf:\n",
      "    # Add best model\n",
      "    zipf.write(f\"{results.save_dir}/weights/best.pt\", \"component_best.pt\")\n",
      "    zipf.write(f\"{results.save_dir}/weights/last.pt\", \"component_last.pt\")\n",
      "    \n",
      "    # Add metrics\n",
      "    zipf.write(f\"{OUTPUT_DIR}/component_training_metrics.json\", \"component_training_metrics.json\")\n",
      "    zipf.write(f\"{OUTPUT_DIR}/component_training_metrics.csv\", \"component_training_metrics.csv\")\n",
      "    \n",
      "    # Add training results\n",
      "    if os.path.exists(f\"{results.save_dir}/results.csv\"):\n",
      "        zipf.write(f\"{results.save_dir}/results.csv\", \"training_results.csv\")\n",
      "    \n",
      "    # Add confusion matrix if exists\n",
      "    if os.path.exists(f\"{results.save_dir}/confusion_matrix.png\"):\n",
      "        zipf.write(f\"{results.save_dir}/confusion_matrix.png\", \"confusion_matrix.png\")\n",
      "\n",
      "print(f\"\\nOutputs zipped to: {zip_path}\")\n",
      "print(f\"File size: {os.path.getsize(zip_path) / 1024 / 1024:.2f} MB\")"
     ]
  },
  {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
      "## Final Summary"
     ]
  },
  {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
      "print(\"=\"*50)\n",
      "print(\"COMPONENT MODEL TRAINING COMPLETE\")\n",
      "print(\"=\"*50)\n",
      "print(f\"\\nFiles to download:\")\n",
      "print(f\"1. {zip_path}\")\n",
      "print(f\"\\nKey results:\")\n",
      "print(f\"- Test mAP50: {metrics['test_map50']:.4f}\")\n",
      "print(f\"- Test mAP50-95: {metrics['test_map50_95']:.4f}\")\n",
      "print(f\"- Test Precision: {metrics['test_precision']:.4f}\")\n",
      "print(f\"- Test Recall: {metrics['test_recall']:.4f}\")\n",
      "print(f\"- Epochs trained: {metrics['epochs_trained']}\")\n",
      "print(f\"- Device: {metrics['device']}\")\n",
      "print(f\"- Image size: {metrics['imgsz']}\")\n",
      "print(f\"\\nTarget: mAP50 >= 0.60\")\n",
      "print(f\"Achieved: {metrics['test_map50']:.4f} - {'PASS' if metrics['test_map50'] >= 0.60 else 'FAIL'}\")"
     ]
  }
 ],
